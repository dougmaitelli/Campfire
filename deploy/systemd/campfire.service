[Unit]
Description=Campfire game server panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=campfire
Group=campfire
StateDirectory=campfire
StateDirectoryMode=0700
WorkingDirectory=/var/lib/campfire
Environment=CAMPFIRE_DATABASE=/var/lib/campfire/panel.db
Environment=CAMPFIRE_LISTEN=127.0.0.1:8080
EnvironmentFile=-/etc/campfire/campfire.env
ExecStart=/usr/local/bin/campfire
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/campfire

[Install]
WantedBy=multi-user.target
