# Copy to /etc/campfire/campfire.env; command-line flags override these values.
CAMPFIRE_DATABASE=/var/lib/campfire/panel.db
CAMPFIRE_LISTEN=127.0.0.1:8080
# Set for browser access through your HTTPS reverse proxy.
# CAMPFIRE_PUBLIC_URL=https://panel.example.com
# Optional OpenID Connect. Register PUBLIC_URL/api/v1/auth/oidc/callback at your provider.
# CAMPFIRE_OIDC_ISSUER=https://identity.example.com
# CAMPFIRE_OIDC_CLIENT_ID=campfire
# CAMPFIRE_OIDC_CLIENT_SECRET=replace-with-provider-secret
# Link an administrator through the UI before disabling password login.
# CAMPFIRE_DISABLE_LOCAL_LOGIN=false
# Enable remote Sparks with a certificate readable by the campfire service user.
# CAMPFIRE_AGENT_LISTEN=0.0.0.0:8443
# CAMPFIRE_AGENT_TLS_CERT=/etc/campfire/tls/panel.crt
# CAMPFIRE_AGENT_TLS_KEY=/etc/campfire/tls/panel.key
