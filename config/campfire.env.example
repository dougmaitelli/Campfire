# Copy to /etc/campfire/campfire.env; command-line flags override these values.
CAMPFIRE_DATABASE=/var/lib/campfire/panel.db
CAMPFIRE_LISTEN=127.0.0.1:8080
# Independent history age limits in days. 0 keeps records forever; restart to apply.
# CAMPFIRE_AUDIT_RETENTION_DAYS=0
# CAMPFIRE_OPERATION_RETENTION_DAYS=0
# Monitoring alerts run independently of browsers; percentages use server allocations.
# 0 disables a resource threshold. Health alerts include Spark/monitoring/quota failures.
# CAMPFIRE_ALERT_CPU_PERCENT=90
# CAMPFIRE_ALERT_MEMORY_PERCENT=90
# CAMPFIRE_ALERT_DISK_PERCENT=90
# CAMPFIRE_ALERT_DURATION_SECONDS=120
# CAMPFIRE_ALERT_INTERVAL_SECONDS=30
# CAMPFIRE_ALERT_HEALTH_ENABLED=true
# Optional Apprise: complete notify endpoint, comma-separated tags/inline target URLs.
# In-app notifications work without Apprise. These URLs may contain credentials.
# CAMPFIRE_APPRISE_URL=http://apprise:8000/notify/campfire
# CAMPFIRE_APPRISE_TAGS=admins,homelab
# CAMPFIRE_APPRISE_URLS=discord://webhook_id/webhook_token
# Set for browser access through your HTTPS reverse proxy.
# CAMPFIRE_PUBLIC_URL=https://panel.example.com
# Optional OpenID Connect. Register PUBLIC_URL/api/v1/auth/oidc/callback at your provider.
# CAMPFIRE_OIDC_ISSUER=https://identity.example.com
# CAMPFIRE_OIDC_CLIENT_ID=campfire
# CAMPFIRE_OIDC_CLIENT_SECRET=replace-with-provider-secret
# Link an administrator through the UI before disabling password login.
# CAMPFIRE_DISABLE_LOCAL_LOGIN=false
# Enable remote Sparks with a certificate readable by the campfire service user.
# CAMPFIRE_AGENT_LISTEN=0.0.0.0:8443
# CAMPFIRE_AGENT_TLS_CERT=/etc/campfire/tls/panel.crt
# CAMPFIRE_AGENT_TLS_KEY=/etc/campfire/tls/panel.key
# Optional off-host backups. Enable sync and configure retention separately per server.
# Credentials use the AWS SDK chain (environment, shared config, or instance role).
# CAMPFIRE_S3_BUCKET=campfire-backups
# CAMPFIRE_S3_REGION=us-east-1
# CAMPFIRE_S3_PREFIX=campfire
# For S3-compatible storage, set the service endpoint and path style when needed.
# CAMPFIRE_S3_ENDPOINT=https://s3.example.com
# CAMPFIRE_S3_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
# AWS_SESSION_TOKEN=optional-session-token
