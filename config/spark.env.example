# Copy to /etc/campfire/spark.env; flags override these values.
SPARK_DATA=/var/lib/spark
# Required for initial enrollment; persisted identity is used on subsequent starts.
# SPARK_PANEL=https://panel.example.com:8443
# SPARK_CA_FILE=/etc/campfire/panel-ca.crt
# SPARK_TOKEN_FILE=/etc/campfire/enrollment.token
# Remove SPARK_TOKEN_FILE after successful enrollment. Keep the token file mode 0600.
