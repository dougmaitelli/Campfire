{
  "schema": 1,
  "name": "Native fixture",
  "description": "Synthetic native definition; no game downloads.",
  "images": { "Alpine": "alpine:3.22" },
  "startup": "sleep {{SECONDS}}",
  "work_dir": "/home/container",
  "user": "1000:1000",
  "variables": [
    {
      "name": "SECONDS",
      "default": "3600",
      "required": true,
      "editable": true,
      "pattern": "^[0-9]+$"
    }
  ]
}
