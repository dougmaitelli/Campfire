{
  "meta": { "version": "PLCN_v2" },
  "name": "Pelican v2 fixture",
  "author": "fixtures@example.invalid",
  "description": "Object-valued configuration and modern aliases.",
  "docker_images": { "Alpine": "alpine:3.22" },
  "startup": "./server --memory {{SERVER_MEMORY}}",
  "config": {
    "files": {
      "server.properties": {
        "parser": "properties",
        "find": {
          "port": "{{server.allocations.default.port}}",
          "name": "{{server.environment.SERVER_NAME}}",
          "memory": "{{server.build.memory_limit}}"
        }
      }
    },
    "startup": { "done": "Ready" },
    "logs": {},
    "stop": "^C"
  },
  "variables": [
    {
      "name": "Server name",
      "description": "",
      "env_variable": "SERVER_NAME",
      "default_value": "Campfire",
      "user_viewable": true,
      "user_editable": true,
      "rules": ["required", "string", "max:64"]
    }
  ]
}
